      "source": [
        "13.employees = [\n",
        "    {\"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"name\": \"Anil\", \"salary\": 65000},\n",
        "    {\"name\": \"Sneha\", \"salary\": 72000},\n",
        "    {\"name\": \"Kiran\", \"salary\": 82000},\n",
        "    {\"name\": \"Meena\", \"salary\": 55000}\n",
        "]\n",
        "Using reduce(), calculate the total payroll directly from the dictionaries"
      ],
      "metadata": {
        "id": "HA6UtlgtII6w"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "employees = [\n",
        "    {\"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"name\": \"Anil\", \"salary\": 65000},\n",
        "    {\"name\": \"Sneha\", \"salary\": 72000},\n",
        "    {\"name\": \"Kiran\", \"salary\": 82000},\n",
        "    {\"name\": \"Meena\", \"salary\": 55000}\n",
        "]\n",
        "total_payroll = reduce(lambda total, emp: total + emp[\"salary\"],employees,0)\n",
        "print(total_payroll)"
      ],
