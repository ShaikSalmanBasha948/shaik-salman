        "Using reduce(), merge all dictionaries into one dictionary."
      ],
      "metadata": {
        "id": "cg11Q7Q_J7w8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "dictionaries = [\n",
        "    {\"name\": \"Rahul\"},\n",
        "    {\"age\": 30},\n",
        "    {\"department\": \"IT\"},\n",
        "    {\"salary\": 65000}\n",
        "]\n",
        "merged_dict = reduce(lambda x, y: {**x, **y}, dictionaries)\n",
        "print(merged_dict)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "bWwVATpEKGV2",
