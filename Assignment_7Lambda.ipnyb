    {
      "cell_type": "markdown",
      "source": [
        "17.products = [\n",
        "    {\"name\": \"Laptop\", \"price\": 55000, \"stock\": 5},\n",
        "    {\"name\": \"Mouse\", \"price\": 600, \"stock\": 25},\n",
        "    {\"name\": \"Keyboard\", \"price\": 1500, \"stock\": 15},\n",
        "    {\"name\": \"Monitor\", \"price\": 18000, \"stock\": 8}\n",
        "]\n",
        "Using reduce(), calculate the total inventory value using price × stock."
      ],
      "metadata": {
        "id": "fjnUNTXHJaVv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "products = [\n",
        "    {\"name\": \"Laptop\", \"price\": 55000, \"stock\": 5},\n",
        "    {\"name\": \"Mouse\", \"price\": 600, \"stock\": 25},\n",
        "    {\"name\": \"Keyboard\", \"price\": 1500, \"stock\": 15},\n",
        "    {\"name\": \"Monitor\", \"price\": 18000, \"stock\": 8}\n",
        "]\n",
        "\n",
        "total_inventory_value = reduce(\n",
        "    lambda total, product: total + (product[\"price\"] * product[\"stock\"]),\n",
        "    products,\n",
        "    0\n",
        ")\n",
        "print(total_inventory_value)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "xHWZLBy_Jhht",
        "outputId": "a808b1ba-8e94-46f7-9a58-8f55ff2e2082"
      },
