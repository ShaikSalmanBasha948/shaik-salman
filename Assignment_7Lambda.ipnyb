    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "students = [\n",
        "    {\"name\": \"Ravi\", \"marks\": 92},\n",
        "    {\"name\": \"Kiran\", \"marks\": 68},\n",
        "    {\"name\": \"Meena\", \"marks\": 85},\n",
        "    {\"name\": \"Ajay\", \"marks\": 48},\n",
        "    {\"name\": \"Sneha\", \"marks\": 79},\n",
        "    {\"name\": \"Rahul\", \"marks\": 95}\n",
        "]\n",
        "filtered_students = filter(lambda student: student[\"marks\"] > 70, students)\n",
        "marks = list(map(lambda student: student[\"marks\"], filtered_students))\n",
        "total_marks = reduce(lambda x, y: x + y, marks, 0)\n",
        "average_marks = total_marks / len(marks)\n",
        "print(\"Marks:\", marks)\n",
        "print(\"Average Marks:\", average_marks)"
      ],
