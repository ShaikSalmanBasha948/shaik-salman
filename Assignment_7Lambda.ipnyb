      "metadata": {
        "id": "tJ6d6d7gEQxq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "numbers=[10,20,30,40,50]\n",
        "add=list(map(lambda x:x+5, numbers))\n",
        "print(add)"
