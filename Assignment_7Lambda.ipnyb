        "7.numbers = [3, 5, 10, 15, 18, 30, 42, 45, 60, 75]\n",
        "Using filter() and reduce():\n",
        "\n",
        "Extract numbers divisible by both 3 and 5.\n",
        "Calculate their total sum."
      ],
      "metadata": {
        "id": "C8mEql3AMK0x"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "numbers = [3, 5, 10, 15, 18, 30, 42, 45, 60, 75]\n",
        "total_sum = reduce(\n",
        "    lambda x, y: x+y,\n",
        "    filter(lambda x: x % 3 == 0 and x % 5 == 0, numbers),0)\n",
        "print(total_sum)"
      ],
      "metadata": {
