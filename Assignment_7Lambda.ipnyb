    {
      "cell_type": "markdown",
      "source": [
        "9.temperatures = [18, 24, 30, 35, 40, 12, 28, 33, 15, 42]\n",
        "Using filter(), map(), and reduce():\n",
        "\n",
        "Extract temperatures greater than 30°C.\n",
        "Convert the selected values into Fahrenheit.\n",
        "Calculate the average Fahrenheit temperature."
      ],
      "metadata": {
        "id": "gF1Qk8PjNPdI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "temperatures = [18, 24, 30, 35, 40, 12, 28, 33, 15, 42]\n",
        "filtered = list(filter(lambda t: t > 30,temperatures))\n",
        "fahrenheit = list(map(lambda t: (t * 9/5)+32,filtered))\n",
        "total = reduce(lambda x, y: x + y, fahrenheit,0)\n",
        "average = total / len(fahrenheit)\n",
        "print(filtered)\n",
        "print(fahrenheit)\n",
        "print(average)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "ydOstMRUPrOT",
        "outputId": "5131fc54-41b3-41a2-d935-a0e6896271c5"
      },
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "[35, 40, 33, 42]\n",
            "[95.0, 104.0, 91.4, 107.6]\n",
            "99.5\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "10.prices = [450, 1200, 2500, 800, 5000, 1500, 7500]\n",
        "Using filter(), map(), and reduce():\n",
        "\n",
        "Extract prices greater than 1000.\n",
        "Apply a 10% discount to every selected price.\n",
        "Calculate the total discounted amount."
      ],
      "metadata": {
        "id": "FZI4SbniQNAH"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "prices = [450, 1200, 2500, 800, 5000, 1500, 7500]\n",
        "filtered = list(filter(lambda price: price > 1000,prices))\n",
        "discounted = list(map(lambda price: price * 0.90,filtered))\n",
        "total_discounted = reduce(lambda x, y: x + y, discounted, 0)\n",
        "print(filtered)\n",
        "print(discounted)\n",
        "print(total_discounted)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "WehVAX2hQSqw",
