      "cell_type": "markdown",
      "source": [
        "14.celsius = 35\n",
        "Write a lambda expression to convert Celsius into Fahrenheit."
      ],
      "metadata": {
        "id": "g1haDQ0J9XPg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "celsius = 35\n",
        "fahrenheit = lambda c:(c* 9/5) +32\n",
        "result = fahrenheit(celsius)\n",
        "print(result)"
