        "19.transactions = [\n",
        "    {\"id\": 1, \"amount\": 1200},\n",
        "    {\"id\": 2, \"amount\": 5200},\n",
        "    {\"id\": 3, \"amount\": 18000},\n",
        "    {\"id\": 4, \"amount\": 2500},\n",
        "    {\"id\": 5, \"amount\": 9600},\n",
        "    {\"id\": 6, \"amount\": 7200}\n",
        "]\n",
        "Using filter(), map(), and reduce():\n",
        "\n",
        "Extract transactions whose amount is greater than 5000.\n",
        "Add 18% GST to every selected transaction.\n",
        "Calculate the grand total after GST."
      ],
      "metadata": {
        "id": "mQ6MANXxU90j"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "transactions = [\n",
        "    {\"id\": 1, \"amount\": 1200},\n",
        "    {\"id\": 2, \"amount\": 5200},\n",
        "    {\"id\": 3, \"amount\": 18000},\n",
        "    {\"id\": 4, \"amount\": 2500},\n",
        "    {\"id\": 5, \"amount\": 9600},\n",
        "    {\"id\": 6, \"amount\": 7200}\n",
        "]\n",
        "filtered_transactions = filter(lambda transaction: transaction[\"amount\"] > 5000,transactions)\n",
        "gst_transactions = list(map(lambda transaction:{\"id\": transaction[\"id\"],\"amount_after_gst\": transaction[\"amount\"] * 1.18},filtered_transactions))\n",
        "grand_total = reduce(lambda total, transaction: total + transaction[\"amount_after_gst\"],gst_transactions,0)\n",
        "print(\"Transactions After GST:\")\n",
        "print(gst_transactions)\n",
        "print(\"\\nGrand Total After GST:\", grand_total)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
