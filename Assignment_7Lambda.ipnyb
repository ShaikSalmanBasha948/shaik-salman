    {
      "cell_type": "markdown",
      "source": [
        "2.numbers = [2, 3, 4, 5]\n",
        "Using reduce(), calculate the product of all numbers."
      ],
      "metadata": {
        "id": "oQh8vyGHFc5Z"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "numbers = [2, 3, 4, 5]\n",
        "product = reduce(lambda x,y: x * y,numbers)\n",
        "print(product)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "YkyNl6utFg6b",
        "outputId": "39ca4c3b-b911-4a78-e6ff-71f547f2ce2e"
      },
      "execution_count": 33,
      "outputs": [
