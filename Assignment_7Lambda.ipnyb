        "12.employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"department\": \"IT\", \"salary\": 45000},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"department\": \"HR\", \"salary\": 65000},\n",
        "    {\"id\": 103, \"name\": \"Sneha\", \"department\": \"IT\", \"salary\": 72000},\n",
        "    {\"id\": 104, \"name\": \"Kiran\", \"department\": \"IT\", \"salary\": 82000},\n",
        "    {\"id\": 105, \"name\": \"Meena\", \"department\": \"Sales\", \"salary\": 55000}\n",
        "]\n",
        "Using filter() and reduce():\n",
        "\n",
        "Extract employees from the IT department.\n",
        "Calculate the total salary of IT employees."
      ],
      "metadata": {
        "id": "-IO7x-udRbem"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"department\": \"IT\", \"salary\": 45000},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"department\": \"HR\", \"salary\": 65000},\n",
        "    {\"id\": 103, \"name\": \"Sneha\", \"department\": \"IT\", \"salary\": 72000},\n",
        "    {\"id\": 104, \"name\": \"Kiran\", \"department\": \"IT\", \"salary\": 82000},\n",
        "    {\"id\": 105, \"name\": \"Meena\", \"department\": \"Sales\", \"salary\": 55000}\n",
        "]\n",
        "it_employees = filter(lambda emp: emp[\"department\"] == \"IT\", employees)\n",
        "total_salary = reduce(lambda total, emp: total + emp[\"salary\"],it_employees,0)\n",
        "print(total_salary)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "KK0ihqk7Rfv6",
