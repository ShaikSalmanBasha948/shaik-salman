    {
      "cell_type": "markdown",
      "source": [
        "14.students = [\n",
        "    {\"name\": \"Ravi\", \"marks\": 92, \"passed\": True},\n",
        "    {\"name\": \"Kiran\", \"marks\": 68, \"passed\": True},\n",
        "    {\"name\": \"Meena\", \"marks\": 85, \"passed\": True},\n",
        "    {\"name\": \"Ajay\", \"marks\": 48, \"passed\": True},\n",
        "    {\"name\": \"Sneha\", \"marks\": 35, \"passed\": False},\n",
        "    {\"name\": \"Rahul\", \"marks\": 95, \"passed\": True}\n",
        "]\n",
        "Using filter() and reduce():\n",
        "\n",
        "Extract students who passed.\n",
        "Find the topper among the passed students."
      ],
      "metadata": {
        "id": "nbjVwVkrSmgX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "students = [\n",
        "    {\"name\": \"Ravi\", \"marks\": 92, \"passed\": True},\n",
        "    {\"name\": \"Kiran\", \"marks\": 68, \"passed\": True},\n",
        "    {\"name\": \"Meena\", \"marks\": 85, \"passed\": True},\n",
        "    {\"name\": \"Ajay\", \"marks\": 48, \"passed\": True},\n",
        "    {\"name\": \"Sneha\", \"marks\": 35, \"passed\": False},\n",
        "    {\"name\": \"Rahul\", \"marks\": 95, \"passed\": True}\n",
        "]\n",
        "passed_students = filter(lambda student: student[\"passed\"], students)\n",
        "topper = reduce(lambda s1, s2: s1 if s1[\"marks\"] > s2[\"marks\"] else s2,passed_students)\n",
        "print(topper)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "oY28dZq2SrOQ",
        "outputId": "1b3e8964-59a7-434f-d4fb-eaceb544acaf"
      },
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "{'name': 'Rahul', 'marks': 95, 'passed': True}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "15.students = [\n",
        "    {\"name\": \"Ravi\", \"marks\": 92},\n",
        "    {\"name\": \"Kiran\", \"marks\": 68},\n",
        "    {\"name\": \"Meena\", \"marks\": 85},\n",
        "    {\"name\": \"Ajay\", \"marks\": 48},\n",
        "    {\"name\": \"Sneha\", \"marks\": 79},\n",
