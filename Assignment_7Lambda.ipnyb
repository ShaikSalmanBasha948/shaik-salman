    {
      "cell_type": "markdown",
      "source": [
        "20.employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"salary\": 65000},\n",
        "    {\"id\": 103, \"name\": \"Sneha\", \"salary\": 72000},\n",
        "    {\"id\": 104, \"name\": \"Kiran\", \"salary\": 82000}\n",
        "]\n",
        "Using map(), create a new list of dictionaries containing:\n",
        "\n",
        "Employee name\n",
        "Original salary\n",
        "Salary after a 10% increment"
      ],
      "metadata": {
        "id": "PLuJD7r_--wS"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"salary\": 65000},\n",
        "    {\"id\": 103, \"name\": \"Sneha\", \"salary\": 72000},\n",
        "    {\"id\": 104, \"name\": \"Kiran\", \"salary\": 82000}\n",
        "]\n",
        "updated= list(map(lambda emp: {\n",
        "    \"name\": emp[\"name\"],\n",
        "    \"original_salary\": emp[\"salary\"],\n",
        "    \"incremented_salary\": emp[\"salary\"] * 1.10\n",
        "}, employees))\n",
        "print(updated)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "W6FE49FY_Eht",
        "outputId": "a0c78e95-70fe-4490-b374-f478ca7b5919"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "[{'name': 'Rahul', 'original_salary': 45000, 'incremented_salary': 49500.00000000001}, {'name': 'Anil', 'original_salary': 65000, 'incremented_salary': 71500.0}, {'name': 'Sneha', 'original_salary': 72000, 'incremented_salary': 79200.0}, {'name': 'Kiran', 'original_salary': 82000, 'incremented_salary': 90200.00000000001}]\n"
          ]
        }
      ]
    },
