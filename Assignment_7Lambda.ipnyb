      "source": [
        "14.employees = [\n",
        "    {\"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"name\": \"Anil\", \"salary\": 65000},\n",
        "    {\"name\": \"Sneha\", \"salary\": 72000},\n",
        "    {\"name\": \"Kiran\", \"salary\": 82000},\n",
        "    {\"name\": \"Meena\", \"salary\": 55000}\n",
        "]\n",
        "Using reduce(), find the employee with the highest salary."
      ],
      "metadata": {
        "id": "aj7oWC7NIgKb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "employees = [\n",
        "    {\"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"name\": \"Anil\", \"salary\": 65000},\n",
        "    {\"name\": \"Sneha\", \"salary\": 72000},\n",
        "    {\"name\": \"Kiran\", \"salary\": 82000},\n",
        "    {\"name\": \"Meena\", \"salary\": 55000}\n",
        "]\n",
        "highest_salary_employee = reduce(\n",
        "    lambda emp1, emp2: emp1 if emp1[\"salary\"] > emp2[\"salary\"] else emp2,\n",
        "    employees)\n",
        "print(highest_salary_employee)"
      ],
      "metadata": {
        "colab": {
