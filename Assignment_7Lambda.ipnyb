        "8.words = [\"madam\", \"python\", \"level\", \"azure\", \"radar\", \"cloud\", \"civic\"]\n",
        "Using filter() and reduce():\n",
        "\n",
        "Extract palindrome words.\n",
        "Join them into one string separated by \" | \"."
      ],
      "metadata": {
        "id": "5vQpR9IcMg1I"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "words = [\"madam\", \"python\", \"level\", \"azure\", \"radar\", \"cloud\", \"civic\"]\n",
        "palindrome_string = reduce(\n",
        "    lambda x, y: x + \"|\" + y,filter(lambda word: word == word[::-1], words))\n",
        "print(palindrome_string)"
      ],
      "metadata": {
