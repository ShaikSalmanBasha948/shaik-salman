      "source": [
        "19.number = -45\n",
        "Write a lambda expression to return the absolute value of the number without using abs()"
      ],
      "metadata": {
        "id": "bSz6EQRa-tiq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "number = -45\n",
        "absolute_value = lambda x: x if x >= 0 else -x\n",
        "result = absolute_value(number)\n",
        "print(result)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "-PpZjBV6-ybX",
        "outputId": "134ae061-46e0-4162-c013-54796b7cb13b"
