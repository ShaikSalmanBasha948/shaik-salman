    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "numbers = [12, 45, 67, 89, 23, 56, 91, 34, 78, 100]\n",
        "even_sum = reduce(lambda x, y: x + y if y % 2 == 0 else x,numbers,0)\n",
        "print(even_sum)"
