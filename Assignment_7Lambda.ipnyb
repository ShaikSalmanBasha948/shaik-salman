    {
      "cell_type": "code",
      "source": [
        "employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"salary\": 45000},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"salary\": 65000},\n",
