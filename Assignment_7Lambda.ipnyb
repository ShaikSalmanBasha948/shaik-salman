            "[15, 25, 35, 45, 55]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "4.numbers = [15, 25, 35, 45, 55]\n",
        "Using map(), subtract 10 from every number."
      ],
      "metadata": {
        "id": "J9Dt9H2LErD7"
      }
    },
    {
      "cell_type": "code",
      "source": [
