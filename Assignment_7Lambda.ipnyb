    {
      "cell_type": "markdown",
      "source": [
        "1.numbers = [10, 20, 30, 40, 50]\n",
        "Using reduce(), calculate the sum of all numbers"
      ],
      "metadata": {
        "id": "ogU94y_mE_rg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "numbers = [10, 20, 30, 40, 50]\n",
        "total_sum = reduce(lambda x, y: x + y, numbers)\n",
        "print(total_sum)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "XKeikOOtFEwe",
        "outputId": "e4585509-7613-49f1-eade-fea6b7b36fad"
