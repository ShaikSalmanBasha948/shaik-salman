      "source": [
        "13.employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"salary\": 45000, \"active\": True},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"salary\": 65000, \"active\": True},\n",
        "    {\"id\": 103, \"name\": \"Sneha\", \"salary\": 72000, \"active\": False},\n",
        "    {\"id\": 104, \"name\": \"Kiran\", \"salary\": 82000, \"active\": True},\n",
        "    {\"id\": 105, \"name\": \"Meena\", \"salary\": 55000, \"active\": True},\n",
        "    {\"id\": 106, \"name\": \"Arjun\", \"salary\": 98000, \"active\": False}\n",
        "]\n",
        "Using filter(), map(), and reduce():\n",
        "\n",
        "Extract active employees.\n",
        "Increase every active employee's salary by 15%.\n",
        "Calculate the total updated payroll."
      ],
      "metadata": {
        "id": "GMO9asRGR3pT"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "employees = [\n",
        "    {\"id\": 101, \"name\": \"Rahul\", \"salary\": 45000, \"active\": True},\n",
        "    {\"id\": 102, \"name\": \"Anil\", \"salary\": 65000, \"active\": True},\n",
        "    {\"id\": 103, \"name\": \"Sneha\", \"salary\": 72000, \"active\": False},\n",
        "    {\"id\": 104, \"name\": \"Kiran\", \"salary\": 82000, \"active\": True},\n",
        "    {\"id\": 105, \"name\": \"Meena\", \"salary\": 55000, \"active\": True},\n",
        "    {\"id\": 106, \"name\": \"Arjun\", \"salary\": 98000, \"active\": False}\n",
        "]\n",
        "\n",
        "active_employees = filter(lambda emp: emp[\"active\"], employees)\n",
        "\n",
        "updated_employees = map(lambda emp: {\"name\": emp[\"name\"],\"updated_salary\": emp[\"salary\"] * 1.15 },active_employees)\n",
        "updated_list = list(updated_employees)\n",
        "total_payroll = reduce(lambda total, emp: total + emp[\"updated_salary\"], updated_list,0)\n",
        "print(\"Updated Employees:\")\n",
        "print(updated_list)\n",
        "print(\"\\nTotal Updated Payroll:\", total_payroll)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
