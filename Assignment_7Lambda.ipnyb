        "20.sales_records = [\n",
        "    {\"salesperson\": \"Rahul\", \"region\": \"South\", \"sales\": 45000, \"active\": True},\n",
        "    {\"salesperson\": \"Anil\", \"region\": \"North\", \"sales\": 65000, \"active\": True},\n",
        "    {\"salesperson\": \"Sneha\", \"region\": \"South\", \"sales\": 72000, \"active\": False},\n",
        "    {\"salesperson\": \"Kiran\", \"region\": \"South\", \"sales\": 82000, \"active\": True},\n",
        "    {\"salesperson\": \"Meena\", \"region\": \"West\", \"sales\": 55000, \"active\": True},\n",
        "    {\"salesperson\": \"Arjun\", \"region\": \"South\", \"sales\": 98000, \"active\": True}\n",
        "]\n",
        "Using filter(), map(), and reduce():\n",
        "\n",
        "Extract active salespeople from the South region.\n",
        "Calculate a 5% incentive for each selected salesperson.\n",
        "Create a list containing salesperson name, sales amount, and incentive.\n",
        "Calculate the total incentive payable."
      ],
      "metadata": {
        "id": "qiLXuvj-Vq1T"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "sales_records = [\n",
        "    {\"salesperson\": \"Rahul\", \"region\": \"South\", \"sales\": 45000, \"active\": True},\n",
        "    {\"salesperson\": \"Anil\", \"region\": \"North\", \"sales\": 65000, \"active\": True},\n",
        "    {\"salesperson\": \"Sneha\", \"region\": \"South\", \"sales\": 72000, \"active\": False},\n",
        "    {\"salesperson\": \"Kiran\", \"region\": \"South\", \"sales\": 82000, \"active\": True},\n",
        "    {\"salesperson\": \"Meena\", \"region\": \"West\", \"sales\": 55000, \"active\": True},\n",
        "    {\"salesperson\": \"Arjun\", \"region\": \"South\", \"sales\": 98000, \"active\": True}\n",
        "]\n",
        "filtered_salespeople = filter(lambda person: person[\"region\"] == \"South\" and person[\"active\"],sales_records)\n",
        "incentive_list = list(map(lambda person:{\"salesperson\": person[\"salesperson\"],\"sales\": person[\"sales\"],\"incentive\": person[\"sales\"] * 0.05 },\n",
        "        filtered_salespeople))\n",
        "total_incentive = reduce(lambda total, person: total + person[\"incentive\"],incentive_list,0)\n",
        "print(\"Incentive Details:\")\n",
        "print(incentive_list)\n",
        "print(total_incentive)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "aCQ3KSgzVv4_",
        "outputId": "5c5e0685-9aa0-465d-8d86-73323fbb5d1c"
      },
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Incentive Details:\n",
