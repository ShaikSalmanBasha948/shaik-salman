        "17.products = [\n",
        "    {\"name\": \"Laptop\", \"price\": 55000, \"category\": \"Electronics\"},\n",
        "    {\"name\": \"Chair\", \"price\": 4500, \"category\": \"Furniture\"},\n",
        "    {\"name\": \"Monitor\", \"price\": 18000, \"category\": \"Electronics\"},\n",
        "    {\"name\": \"Desk\", \"price\": 8500, \"category\": \"Furniture\"},\n",
        "    {\"name\": \"SSD\", \"price\": 6500, \"category\": \"Electronics\"}\n",
        "]\n",
        "Using filter(), map(), and reduce():\n",
        "\n",
        "Extract products belonging to the Electronics category.\n",
        "Apply a 20% discount.\n",
        "Calculate the total discounted value."
      ],
      "metadata": {
        "id": "9XXWbrSST6sW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from functools import reduce\n",
        "\n",
        "products = [\n",
        "    {\"name\": \"Laptop\", \"price\": 55000, \"category\": \"Electronics\"},\n",
        "    {\"name\": \"Chair\", \"price\": 4500, \"category\": \"Furniture\"},\n",
        "    {\"name\": \"Monitor\", \"price\": 18000, \"category\": \"Electronics\"},\n",
        "    {\"name\": \"Desk\", \"price\": 8500, \"category\": \"Furniture\"},\n",
        "    {\"name\": \"SSD\", \"price\": 6500, \"category\": \"Electronics\"}\n",
        "]\n",
        "electronics = filter(lambda product: product[\"category\"] == \"Electronics\",products)\n",
        "discounted_products = list(map(lambda product: {\"name\": product[\"name\"],\"discounted_price\": product[\"price\"] * 0.80},electronics))\n",
        "\n",
        "total_discounted_value = reduce(lambda total, product: total + product[\"discounted_price\"],discounted_products,0)\n",
        "print(\"Discounted Products:\")\n",
        "print(discounted_products)\n",
        "print(\"\\nTotal Discounted Value:\", total_discounted_value)"
      ],
